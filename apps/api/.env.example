# Copy to .env for local development (docker compose up -d provides Postgres and Mailpit).

PORT=3000
DATABASE_URL=postgres://kniho:kniho@localhost:5434/kniho
DATABASE_SSL=false
# At least 32 characters.
JWT_SECRET=local-development-secret-change-me-please
# The web app: password reset links point here, and it is the default CORS origin.
APP_BASE_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,https://kniho-hlod.vercel.app
# TRUST_PROXY=1

EMAIL_FROM=Kniho-hlod <noreply@kniho-hlod.local>
# Email: RESEND_API_KEY wins, then SMTP_HOST; without either, emails are only logged.
# RESEND_API_KEY=re_...
SMTP_HOST=localhost
SMTP_PORT=1025

# ISBN lookup: a Google Books API key (Google Cloud → Books API) gives the lookup its own daily
# quota; without it Google's shared anonymous quota is usually used up and only Open Library answers.
# GOOGLE_BOOKS_API_KEY=

# File storage: without R2_BUCKET, uploads are kept in memory (lost on restart).
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=kniho-hlod
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=https://files.example.com

# Production (NODE_ENV=production) refuses to start without email and R2. For a first deploy
# before those accounts exist: emails are then only logged, uploads kept in memory.
# ALLOW_MISSING_EMAIL_AND_STORAGE=true

# pnpm seed:admin
ADMIN_EMAIL=admin@kniho-hlod.local
ADMIN_PASSWORD=change-me-please
ADMIN_DISPLAY_NAME=Admin
